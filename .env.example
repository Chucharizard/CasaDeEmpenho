# Copiar como .env para personalizar la instalación local.
# Las claves se generan automáticamente; no compartir el .env ni los datos.
APP_HOST=127.0.0.1
APP_PORT=5000
CLIENT_ACCESS_ENABLED=0
ENABLE_DEV_LOGIN=0

# Opcional: carpeta persistente para base, uploads y claves.
# CASAEMPENO_DATA_DIR=C:/Datos/Panda

# Opcional: ubicación de respaldos; debe ser distinta de la base activa.
# BACKUP_DIR=C:/Respaldos/Panda
